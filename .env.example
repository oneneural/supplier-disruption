# Supplier disruption configuration. Copy to .env for host-side development:
#   cp .env.example .env
# Host commands (corepack pnpm db:migrate, db:seed, start:api, start:worker)
# run from the repository root and load .env, so relative *_FILE paths resolve there.
# Every secret accepts NAME or NAME_FILE, never both. Values below are paths
# produced by `sh scripts/init-secrets.sh`, or placeholders; no secret belongs here.

# Identity and public origin (Better Auth base URL and the exact trusted origin).
APP_ID=supplier-disruption
APP_ORIGIN=http://127.0.0.1:3102

# Modes. The pilot accepts only fixture/rules/fixture; anything else fails startup.
DATA_MODE=fixture
AGENT_MODE=rules
AUTH_MODE=fixture

# Email extraction agent (ADR 0011), read by the API only. none (default) makes
# every email case pause agent_provider_unavailable with no model call.
# anthropic reads the key from ANTHROPIC_API_KEY_FILE only; the key is never
# logged or returned. Each run stops at AGENT_RUN_COST_CAP_USD (at most 1) and
# at AGENT_TOOL_BUDGET tool calls (1 to 12).
AGENT_PROVIDER=none
AGENT_MODEL=claude-haiku-5-5
AGENT_TOOL_BUDGET=10
AGENT_RUN_COST_CAP_USD=0.05
# Limit on the project spend ledger (ADR 0017), shared by the API and
# evaluation/run.mjs: a metered run first reserves its run cap and pauses
# agent_spend_cap_reached, with no model call, if opening, settled and reserved
# spend plus that cap would pass this total. At most 15, the owner's pause,
# which also applies when this is unset. The ledger refuses every metered run
# until an operator opens it with the reconciled total (docs/development.md).
AGENT_TOTAL_COST_CAP_USD=1
# ANTHROPIC_API_KEY_FILE=.secrets/anthropic_api_key

# production | development | test. Better Auth rate limiting is on only in production.
# test is for automated tests only: it enables the worker's test hooks. The API
# keeps origin and CSRF checks on under every value.
NODE_ENV=development
LOG_LEVEL=info

# Business time for domain records: system (default) samples real time. controlled
# reads the fixture clock row and is accepted only with NODE_ENV=test and
# DATA_MODE=fixture, for automated tests. demonstration (ADR 0012) reads the same
# row in any NODE_ENV, labels it simulated, replays the recorded C-01 agent run
# and enables the demonstration controls; `corepack pnpm demo` sets it for its
# own project. Operational timers always use real time.
DOMAIN_CLOCK_MODE=system

# Keep this at 3001 with the current web app, whose fixed /api rewrite targets
# http://127.0.0.1:3001. Changing only API_PORT breaks that pairing.
API_PORT=3001

# Database roles. The URLs below point at the compose.dev.yaml loopback port 55102.
# Optional compose.dev.yaml override; normal Compose publishes no database port.
# SD_DB_HOST_PORT=55102
# If changed, update and verify every host database URL file to use the same port.
# Container database URLs keep db:5432; the host-port override does not change them.
# Migrator: schema owner, used only by db:migrate and db:seed.
DATABASE_URL_MIGRATOR_FILE=.secrets/host/database_url_migrator
# API: auth, business records and pg-boss producer access. evaluation/run.mjs
# --mode live also uses it to admit each case through the project spend ledger.
DATABASE_URL_API_FILE=.secrets/host/database_url_api
# Worker: pg-boss consumer and its heartbeat table only.
DATABASE_URL_WORKER_FILE=.secrets/host/database_url_worker
# Role names the migrator grants to (defaults shown).
DB_API_ROLE=sd_api
DB_WORKER_ROLE=sd_worker

# Better Auth signing/encryption secret (at least 32 characters).
BETTER_AUTH_SECRET_FILE=.secrets/better_auth_secret
# Worker-to-API service credential (at least 32 characters).
WORKER_SERVICE_TOKEN_FILE=.secrets/worker_service_token

# Synthetic fixture passwords, read only by db:seed (at least 12 characters).
FIXTURE_BUYER_PASSWORD_FILE=.secrets/fixture_buyer_password
FIXTURE_MANAGER_PASSWORD_FILE=.secrets/fixture_manager_password

# Container boot ID file. The app image points every service at /run/sd/boot-id,
# and NODE_ENV=production requires it. Leave it unset on the host, where the
# worker generates its own boot ID.
# BOOT_ID_FILE=

# Recorded on the worker heartbeat. The app image sets it from its build argument.
BUILD_REVISION=local

# Compose interpolation for the app image (compose.yaml). Leave unset for the
# documented stack on 127.0.0.1:3102; the container tests set them for
# disposable projects. Containers receive only the environment compose.yaml
# declares, never this file.
# SD_APP_HOST_PORT=3102
# SD_APP_IMAGE=supplier-disruption-app:local
# SD_BUILD_REVISION=local

# ERPNext sandbox connector proof (ADR 0018). Read only by the opt-in
# `corepack pnpm test:sandbox`; the API, worker, demonstration and containers
# never load these. Leave both required values unset and the live proof skips.
# The base URL must be a loopback IP origin (127.0.0.1 or [::1]) of the disposable sandbox. The
# credentials file stays outside the repository and holds the sandbox's API
# principals as KEY=value lines (SD_API_USER, SD_API_KEY and SD_API_SECRET for
# the reader; SD_PROBE_USER, SD_PROBE_API_KEY and SD_PROBE_API_SECRET for the
# probe writer). It is read at run time and never logged or recorded.
# ERPNEXT_BASE_URL=http://127.0.0.1:18082
# ERPNEXT_CREDENTIALS_FILE=
# Per-request client timeout in milliseconds (100 to 120000, default 10000).
# ERPNEXT_TIMEOUT_MS=10000
# When set, the proof writes redacted request, response and read-back evidence here.
# ERPNEXT_EVIDENCE_DIR=docs/evidence/erpnext-sandbox

# Test-only worker hooks (PILOT_TEST_HOLD_AT, PILOT_TEST_HANDLER_DELAY_MS) are
# rejected unless NODE_ENV=test. Do not set them here.
